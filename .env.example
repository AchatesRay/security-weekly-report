# 腾讯云翻译 API（translate.provider=tencent 时使用）
TMT_SECRET_ID=your_tencent_secret_id
TMT_SECRET_KEY=your_tencent_secret_key

# 百度翻译开放平台（translate.provider=baidu 时使用）
BAIDU_APPID=your_baidu_appid
BAIDU_KEY=your_baidu_key

# 管理后台 HTTP Basic Auth（留空则不启用）
CONFIG_USERNAME=admin
CONFIG_PASSWORD=your_password

# 可选：提高 API 频率限制
SCHOLAR_API_KEY=
GITHUB_TOKEN=
