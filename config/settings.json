{
  "dedup": {
    "similarity_threshold": 75,
    "max_days": 7,
    "near_dup_hamming": 3,
    "window_hours": 72,
    "ledger_ttl_days": 21,
    "near_dup_enabled": true,
    "ledger_enabled": true
  },
  "translate": {
    "timeout": 8,
    "fields": [
      "title",
      "ai_summary"
    ],
    "only_displayed": true,
    "cache_enabled": true,
    "retry_times": 3,
    "cache_max_entries": 20000,
    "provider": "baidu"
  },
  "summary": {
    "max_chars": 500,
    "short_max_chars": 300,
    "short_categories": [
      "④ 政策法规与标准框架",
      "⑤ 产业动态与技术趋势"
    ],
    "min_chars": 80
  },
  "category_order": [
    "① AI/LLM 安全",
    "② 威胁情报与攻防对抗",
    "③ 漏洞态势与供应链安全",
    "④ 政策法规与标准框架",
    "⑤ 产业动态与技术趋势",
    "⑥ 数据安全与隐私保护",
    "⑦ 产业与商业动态",
    "未分类"
  ],
  "reader_profile": {
    "max_total_items": 120
  },
  "report": {
    "rolling": {
      "enabled": true,
      "window_days": 14,
      "max_per_source": 8
    }
  },
  "quality": {
    "authority_multipliers": {
      "S": 1.2,
      "A": 1.1,
      "B": 1.0,
      "C": 0.85
    },
    "depth_bonus_max": 60,
    "commercial_penalty_max": 100,
    "series_penalty": 25,
    "source_tiers": {
      "default_by_group": {
        "政府与CERT": "S",
        "标准框架": "S",
        "安全厂商": "A",
        "开发者社区": "B",
        "安全媒体": "B",
        "国内信源": "B",
        "AI厂商": "B"
      },
      "overrides": {
        "Google Project Zero": "S",
        "Unit 42": "S",
        "Cisco Talos Blog": "S",
        "Microsoft Security Blog": "S",
        "MSRC": "S",
        "Mandiant / Google Cloud Threat Intel": "S",
        "Google Cloud Security Blog": "S",
        "AWS Security Blog": "S",
        "NIST Cybersecurity Insights": "S",
        "CISA Alerts": "S",
        "NCSC UK": "S",
        "SANS ISC": "S",
        "PortSwigger Research": "S",
        "DFIR Report": "S",
        "Sekoia Blog": "S",
        "ESET WeLiveSecurity": "S",
        "Kaspersky Securelist": "S",
        "Zero Day Initiative": "S",
        "arXiv cs.CR": "S",
        "IETF Datatracker": "S",
        "MITRE ATT&CK": "S",
        "GitHub Security Lab": "S",
        "Praetorian Blog": "S",
        "Embrace The Red": "S",
        "AI Hot": "C",
        "Hacker News": "C",
        "Reddit r/netsec": "C",
        "Packet Storm Security": "C"
      }
    },
    "quotas": {
      "max_per_source": 3
    }
  },
  "fetch": {
    "min_host_interval_seconds": 0.6,
    "max_per_host_concurrency": 2,
    "host_concurrency": {
      "wechat2rss.xlab.app": 1
    }
  },
  "fulltext": {
    "fallback_enabled": true
  },
  "images": {
    "enabled": true,
    "max_bytes": 5242880,
    "max_per_article": 12,
    "timeout": 10,
    "concurrency": 4,
    "retention_days": 14
  },
  "output": {
    "precompress": false
  }
}
